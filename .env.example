# ─── MOMENTUM Configuration ───────────────────────────────────────────
# Copy this to .env and fill in your values

# Server
PORT=8080
HOST=0.0.0.0

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change-me-to-a-random-string

# Stripe (get these from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...   # Your Stripe price ID for $9/mo

# App URL (for Stripe redirects and CORS)
APP_URL=http://localhost:8080

# Admin email (receives new signup notifications)
ADMIN_EMAIL=you@example.com

# Optional: Pix payment config for Brazil
PIX_KEY=
