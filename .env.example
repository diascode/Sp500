# ─── MOMENTUM Configuration (S&P 500 Scanner) ─────────────────────────────
# Copy this file to .env and fill in values before running: docker compose up
# NEVER commit .env to version control.

# REQUIRED — generate with: openssl rand -hex 64
JWT_SECRET=

# REQUIRED — public URL of the app (no trailing slash)
APP_URL=http://localhost:8080

# OPTIONAL — Stripe integration (leave blank to disable payments)
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_WEBHOOK_SECRET=

# OPTIONAL — set to 'development' to disable the JWT_SECRET safety guard locally
NODE_ENV=production

# OPTIONAL — Resend email integration (https://resend.com)
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=noreply@yourdomain.com

# Admin account email — the user who signs up with this email will be auto-promoted to admin.
# On server start, if this account already exists, it is promoted to admin tier automatically.
ADMIN_EMAIL=your-admin-email@example.com

# OPTIONAL — Telegram AI Support Bot
# Create bot via @BotFather on Telegram, get token with /newbot
TELEGRAM_BOT_TOKEN=
# Your personal Telegram chat ID — receive escalation alerts (get via @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=
# Anthropic Claude API key — https://console.anthropic.com
ANTHROPIC_API_KEY=
