# ─── MOMENTUM Configuration ─────────────────────────────────────────────────
# Copy this file to .env and fill in values before running: docker compose up
# NEVER commit .env to version control.

# REQUIRED — generate with: openssl rand -hex 64
JWT_SECRET=

# REQUIRED — public URL of the app (no trailing slash)
APP_URL=http://localhost:8080

# OPTIONAL — Stripe integration (leave blank to disable payments)
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_WEBHOOK_SECRET=

# OPTIONAL — set to 'development' to disable the JWT_SECRET safety guard locally
NODE_ENV=production

# OPTIONAL — Pix payment config for Brazil (future Sprint 3)
PIX_KEY=
